{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" prompt", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" stop", "timeout": 10 } ] }
    ]
  }
}
